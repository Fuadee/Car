# Supabase ฝั่งเซิร์ฟเวอร์เท่านั้น
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ใช้จำกัดระยะเวลาการจองต่อรายการ (ชั่วโมง)
MAX_BOOKING_HOURS=168

# ป้องกันหน้า /admin/vehicle-bookings ก่อนนำขึ้นใช้งานจริง
ADMIN_SESSION_SECRET=

# LINE Messaging API (server-side only; do not use NEXT_PUBLIC_)
LINE_CHANNEL_ACCESS_TOKEN=
LINE_GROUP_ID=

# Public production URL used in LINE notification deep links
APP_URL=

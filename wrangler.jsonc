{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "site-creator-vinext-starter",
  "compatibility_date": "2026-05-22",
  "keep_vars": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "main": "./worker/index.ts",
  "assets": {
    "directory": "dist/client",
    "not_found_handling": "none",
    "binding": "ASSETS"
  },
  "images": {
    "binding": "IMAGES"
  }
}
